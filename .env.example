# ============================================
# ChakrAI Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit your real .env file

# Database Configuration
# Get this from your Neon PostgreSQL dashboard
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# OpenAI Configuration (Required for AI chat functionality)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ElevenLabs Configuration (Required for voice synthesis)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# JWT Authentication Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-secure-random-secret-here

# Stripe Payment Configuration (Required for premium subscriptions)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_YEARLY_PRICE_ID=price_your_yearly_price_id

# EHR Integration Encryption (Optional)
EHR_ENCRYPTION_KEY=your_ehr_encryption_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend API URL (for production deployment)
# VITE_API_URL=https://your-domain.com
