# =================================================================
# CHAKRAI ENVIRONMENT VARIABLES - TEMPLATE
# =================================================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
SESSION_SECRET=your_256_bit_random_secret_here # Required for Express-Session

# DATABASE (PostgreSQL + Drizzle)
DATABASE_URL=postgresql://user:password@localhost:5432/chakrai
DIRECT_URL=postgresql://user:password@localhost:5432/chakrai # For migrations

# AI SERVICES (OpenAI + ElevenLabs)
OPENAI_API_KEY=sk-xxxx...
ELEVENLABS_API_KEY=your_elevenlabs_key_here # For voice synthesis

# SECURITY & ENCRYPTION
# Required for AES-256-CBC encryption of therapeutic content
JOURNAL_ENCRYPTION_KEY=32_character_hex_key_for_aes_256
JWT_SECRET=your_jwt_signing_secret_here # For SecureAuthManager

# PAYMENT SYSTEM (Stripe)
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_... # Critical for subscription validation

# REGULATORY & COMPLIANCE
# Toggle for strict PHI handling
HIPAA_COMPLIANCE_MODE=true
DATA_RETENTION_YEARS=7